---
import { getLocaleFromAstro, getTranslations } from '../i18n';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import '../styles/product-cheat-page.css';
import '../styles/products-showcase.css';
import { getProductPages } from '../data/products';
import SectionHeader from './SectionHeader.astro';
import ProductsShowcase from './ProductsShowcase.astro';

const productPages = getProductPages(locale);
const s = t.products;
---

<section id="products" class="py-16 md:py-24 overflow-visible" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5 overflow-visible">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" />

    <ProductsShowcase products={productPages} class="mt-12" />
  </div>
</section>