---
import { getLocaleFromAstro, getTranslations } from '../../i18n';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import type { ProductPage } from '../../data/products';
import { formatPlanPrice, getProductPlans } from '../../data/productPricing';
import Icon from '../icons/Icon.astro';
import ProductIconWell from './ProductIconWell.astro';
import { Button } from '@/components/starwind/button';
import { CHECKOUT_LINK_REL } from '../../config/checkout';
import { ROUTES, getLocalizedPath } from '../../utils/path';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const plans = getProductPlans(product.slug);
const lifetimePlan = plans.find((p) => p.id === 'lifetime');

const isUgc = product.slug === 'ugc';
const isRustCheat = product.slug === 'rust-cheat';
const isFillCard = isUgc || isRustCheat;
const statusHref = getLocalizedPath(ROUTES.status, locale);
const ugcModuleChips = ['Unban tool', 'Appeals & recovery', 'Windows 10/11'];
const rustModuleChips = ['ESP', 'Aimbot', 'Weapon', 'Misc', 'Config', 'Windows 10/11'];

const planHint =
  t.pricing.checkoutPlanHint ??
  'Want a different plan? Choose it on the next page. You confirm your plan and total at checkout.';
const recommendedLabel = t.pricing.recommended ?? 'Recommended';
---

<aside
  class="product-checkout text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
>
  <div
    class:list={[
      'product-checkout__shell overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15',
      isFillCard && 'product-checkout__shell--fill',
    ]}
  >
    <div class="card-title-band relative z-[1] flex items-center justify-start gap-3 px-5 py-4 text-left">
      <ProductIconWell name="acqPackage" iconSize={20} class="bg-primary/15" />
      <div class="min-w-0 text-left">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">{t.pricing.checkout}</p>
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug">
          {t.pricing.ourPlans ?? 'Our plans'}
        </h2>
      </div>
    </div>

    <div
      class:list={[
        'relative z-[1] px-5 pb-5 pt-5',
        isFillCard ? 'product-checkout__body flex min-h-0 flex-1 flex-col gap-4' : 'space-y-5',
      ]}
    >
      {
        isUgc && (
          <div class="product-checkout__modules rounded-xl border border-border bg-background p-3">
            <ul class="product-checkout__module-chips m-0 flex list-none flex-wrap gap-1.5 p-0" aria-label="Product scope">
              {ugcModuleChips.map((chip) => (
                <li class="product-checkout__module-chip">{chip}</li>
              ))}
            </ul>
          </div>
        )
      }
      {
        isRustCheat && (
          <div class="product-checkout__modules rounded-xl border border-border bg-background p-3">
            <ul class="product-checkout__module-chips m-0 flex list-none flex-wrap gap-1.5 p-0" aria-label="Modules included">
              {rustModuleChips.map((chip) => (
                <li class="product-checkout__module-chip">{chip}</li>
              ))}
            </ul>
            <p class="product-checkout__module-links mt-2 text-xs text-muted-foreground">
              <a href="#requirements" class="text-primary hover:underline">
                Requirements
              </a>
              <span class="text-border" aria-hidden="true">
                {' · '}
              </span>
              <a href={statusHref} class="text-primary hover:underline">
                Status page
              </a>
            </p>
          </div>
        )
      }

      <div class:list={['flex flex-col gap-2', isFillCard && 'min-h-0 flex-1']}>
        {
          plans.map((plan) => (
            <div
              class:list={[
                'product-checkout__plan flex items-center justify-between gap-3 rounded-xl border p-3.5',
                plan.id === 'mon'
                  ? 'product-checkout__plan--recommended border-primary bg-primary/10'
                  : 'border-border bg-background',
              ]}
            >
              <span class="flex min-w-0 flex-col gap-1">
                <span class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-medium">{plan.label}</span>
                  {plan.id === 'mon' && (
                    <span class="product-checkout__recommended">{recommendedLabel}</span>
                  )}
                  {plan.id === 'lifetime' && (
                    <span class="product-checkout__best-value">{t.pricing.bestValue}</span>
                  )}
                </span>
                {plan.id === 'lifetime' && (
                  <span class="product-checkout__save">
                    {t.pricing.saveAmount ?? 'Pay once, use forever'}
                  </span>
                )}
              </span>
              <span class="shrink-0 text-sm font-semibold tabular-nums text-foreground">
                {formatPlanPrice(plan.priceUsd)}
              </span>
            </div>
          ))
        }
      </div>

      {
        isFillCard ? (
          <div class="product-checkout__footer mt-auto space-y-3 border-t border-border pt-4">
            <Button
              as="a"
              href={product.buyUrl}
              variant="primary"
              size="lg"
              class="product-checkout__buy group/buy w-full rounded-xl"
              rel={CHECKOUT_LINK_REL}
              data-astro-reload
              data-astro-prefetch="false"
            >
              {t.pricing.buyNow}
              <span class="product-checkout__buy-arrow inline-flex transition-transform duration-200 ease-out group-hover/buy:translate-x-1">
                <Icon name="arrowRight" size={17} />
              </span>
            </Button>
            <p class="product-checkout__plan-hint m-0 text-center text-xs leading-snug text-muted-foreground">
              {planHint}
            </p>
          </div>
        ) : (
          <div class="space-y-3 border-t border-border pt-4">
            <Button
              as="a"
              href={product.buyUrl}
              variant="primary"
              size="lg"
              class="product-checkout__buy group/buy w-full rounded-xl"
              rel={CHECKOUT_LINK_REL}
              data-astro-reload
              data-astro-prefetch="false"
            >
              {t.pricing.buyNow}
              <span class="product-checkout__buy-arrow inline-flex transition-transform duration-200 ease-out group-hover/buy:translate-x-1">
                <Icon name="arrowRight" size={17} />
              </span>
            </Button>
            <p class="product-checkout__plan-hint m-0 text-center text-xs leading-snug text-muted-foreground">
              {planHint}
            </p>
          </div>
        )
      }
    </div>
  </div>
</aside>