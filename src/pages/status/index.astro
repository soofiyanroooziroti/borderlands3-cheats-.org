---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../../config/seo';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  STATUS_BEFORE_LAUNCH,
  STATUS_GAME_NOTES,
  STATUS_GAME_NOTES_HEADING,
  STATUS_LEGEND,
  STATUS_LOG,
  STATUS_PREVIOUS_UPDATE,
  status,
  statusBadgeLabel,
  statusPageLabel,
  type StatusTone,
} from '../../data/status';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';

const seo = resolvePageSeo('/status/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Status', path: '/status/' },
];
const pageLabel = statusPageLabel(status.state);
const badgeLabel = statusBadgeLabel(status.state);
const statusAria = `Current status: ${badgeLabel}, checked ${status.checkedDate}`;

const STATUS_SEGMENTS: { tone: StatusTone; label: string }[] = [
  { tone: 'green', label: 'Active' },
  { tone: 'blue', label: 'Updating' },
  { tone: 'red', label: 'Not updated' },
];

function legendTooltip(tone: StatusTone): string {
  const item = STATUS_LEGEND.find((entry) => entry.tone === tone);
  if (!item) return '';
  return `${item.label}: ${item.meaning}`;
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/status/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="status-page border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mt-8 space-y-4">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">Borderlands 3 Cheats</p>
        <h1 id="status-page-title" class="text-3xl font-bold md:text-4xl">Borderlands 3 Cheat Status</h1>
        <div class="status-widget" role="status" aria-label={statusAria} data-state={status.state}>
          <div class="status-bar">
            {
              STATUS_SEGMENTS.map((segment) => (
                <span
                  class:list={[
                    'status-bar__segment',
                    segment.tone === status.state && 'status-bar__segment--active',
                    `status-bar__segment--${segment.tone}`,
                  ]}
                  tabindex="0"
                  aria-describedby={`status-tip-${segment.tone}`}
                >
                  <span
                    class:list={[
                      'status-bar__dot',
                      segment.tone === status.state && 'status-bar__dot--pulse',
                    ]}
                    aria-hidden="true"
                  />
                  <span class="status-bar__label">{segment.label}</span>
                  <span id={`status-tip-${segment.tone}`} class="status-bar__tooltip" role="tooltip">
                    {legendTooltip(segment.tone)}
                  </span>
                </span>
              ))
            }
          </div>
          <p class="status-widget__meta">
            <span class="status-widget__headline">{pageLabel}</span>
            <span class="status-widget__checked">Checked {status.checkedDate}</span>
          </p>
        </div>
        <p class="status-launch-line text-sm text-muted-foreground">Check this page before every launch.</p>
      </header>

      <ul class="status-legend" role="list">
        {
          STATUS_LEGEND.map((item) => (
            <li
              class:list={['status-legend__item', item.tone === status.state && 'status-legend__item--current']}
            >
              <span class:list={['status-legend__dot', `status-legend__dot--${item.tone}`]} aria-hidden="true" />
              <span>
                <strong>{item.label}.</strong> {item.meaning}
              </span>
            </li>
          ))
        }
      </ul>

      <section class="mt-12" aria-labelledby="status-ac-title">
        <h2 id="status-ac-title" class="text-lg font-semibold">Before you launch</h2>
        <ol class="status-notes mt-4" role="list">
          {
            STATUS_BEFORE_LAUNCH.map((line) => (
              <li>
                <p class="text-sm font-semibold text-foreground">{line}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-10" aria-labelledby="status-game-title">
        <h2 id="status-game-title" class="text-lg font-semibold">{STATUS_GAME_NOTES_HEADING}</h2>
        <ol class="status-notes mt-4" role="list">
          {
            STATUS_GAME_NOTES.map((entry) => (
              <li>
                <p class="text-sm font-semibold text-foreground">{entry.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{entry.summary}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{STATUS_PREVIOUS_UPDATE}</p>
      </section>

      <section class="mt-10" aria-labelledby="status-log-title">
        <h2 id="status-log-title" class="text-lg font-semibold">Status log</h2>
        <ol class="status-notes mt-4" role="list">
          {
            STATUS_LOG.map((entry) => (
              <li>
                <p class="text-sm font-semibold text-foreground">
                  {entry.date} · {entry.state} · {entry.note}
                </p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .status-widget {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .status-bar {
    display: inline-flex;
    max-width: 100%;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    padding: 0.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in oklch, var(--muted) 35%, transparent);
  }

  .status-bar__segment {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 6px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 14px;
    line-height: 1.25;
    font-weight: 600;
    color: var(--muted-foreground);
    background: transparent;
    cursor: default;
    transition:
      color 300ms ease,
      background-color 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .status-bar__segment--active.status-bar__segment--green {
    color: #052e16;
    background: #22c55e;
    border-color: #16a34a;
    box-shadow: 0 0 14px rgb(34 197 94 / 45%);
  }

  .status-bar__segment--active.status-bar__segment--blue {
    color: #eff6ff;
    background: #2563eb;
    border-color: #1d4ed8;
    box-shadow: 0 0 14px rgb(37 99 235 / 45%);
  }

  .status-bar__segment--active.status-bar__segment--red {
    color: #fef2f2;
    background: #ef4444;
    border-color: #dc2626;
    box-shadow: 0 0 14px rgb(239 68 68 / 45%);
  }

  .status-bar__segment:not(.status-bar__segment--active) {
    border-color: color-mix(in oklch, var(--border) 80%, transparent);
  }

  .status-bar__dot {
    width: 0.45rem;
    height: 0.45rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.35;
    transition: background-color 300ms ease;
  }

  .status-bar__segment--active .status-bar__dot {
    opacity: 1;
  }

  .status-bar__dot--pulse {
    animation: status-dot-pulse 2.4s ease-in-out infinite;
  }

  @keyframes status-dot-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-bar__dot--pulse {
      animation: none;
    }
  }

  .status-bar__tooltip {
    position: absolute;
    z-index: 20;
    left: 50%;
    bottom: calc(100% + 0.45rem);
    width: max-content;
    max-width: 16rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--card);
    color: var(--foreground);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.35;
    text-align: left;
    box-shadow: 0 4px 14px rgb(0 0 0 / 18%);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .status-bar__segment:hover .status-bar__tooltip,
  .status-bar__segment:focus-visible .status-bar__tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .status-bar__segment:focus {
    outline: none;
  }

  .status-bar__segment:focus-visible {
    outline: 2px solid color-mix(in oklch, var(--primary) 70%, transparent);
    outline-offset: 2px;
  }

  .status-widget__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .status-widget__headline {
    font-weight: 600;
    color: var(--foreground);
  }

  .status-widget__checked {
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .status-launch-line {
    margin: 24px 0 0;
  }

  .status-legend {
    display: grid;
    gap: 0.75rem;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .status-legend__item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .status-legend__item--current {
    font-weight: 700;
  }

  .status-legend__dot {
    width: 0.85rem;
    height: 0.85rem;
    margin-top: 0.28rem;
    flex-shrink: 0;
    border-radius: 999px;
  }

  .status-legend__dot--green {
    background: #22c55e;
  }

  .status-legend__dot--red {
    background: #ef4444;
  }

  .status-legend__dot--blue {
    background: #3b82f6;
  }

  .status-notes {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .status-notes li {
    border-left: 2px solid color-mix(in oklch, var(--primary) 40%, transparent);
    padding-left: 0.9rem;
  }
</style>
